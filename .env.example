# ==============================================================================
# Heritage Textile & Handloom Supply Chain Tracker - Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Option A: Individual Parameters)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root@123
DB_NAME=heritage_handloom

# Optional SSL Settings for Hosted Cloud MySQL (e.g. TiDB Cloud, Aiven):
# Set to 'true' or 'required' if your cloud provider requires SSL/TLS.
DB_SSL=false
# DB_SSL_CA=/path/to/ca-cert.pem

# ------------------------------------------------------------------------------
# 2. Database Configuration (Option B: Single Cloud URL)
# ------------------------------------------------------------------------------
# Supported on Railway, Render, Heroku, etc.
# DATABASE_URL=mysql://user:password@cloud-host.com:3306/heritage_handloom

# ------------------------------------------------------------------------------
# 3. Application Security
# ------------------------------------------------------------------------------
# Must be a cryptographically secure random string (minimum 32 characters)
SECRET_KEY=heritage_handloom_super_secret_key_32bytes_sha256!

# ------------------------------------------------------------------------------
# 4. Flask Server Settings
# ------------------------------------------------------------------------------
FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=false
PORT=5000
